# ======================================================================
# Cambodian ALPR — .gitignore
# Keep: code, scripts, docs, small configs, small metrics.
# Ignore: datasets, model weights, venv, training runs, secrets.
# ======================================================================

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# --- Secrets / credentials (NEVER commit your Roboflow API key) ---
.env
.env.*
*.key
secrets.*
**/roboflow_config.*

# --- Datasets (large, regenerable / downloaded from Roboflow) ---
data/raw/
data/interim/
data/annotated/
data/auto_labeled/
data/crnn_crops/
data/crnn_crops_augmented/
data/synthetic/
data/**/images/
data/**/labels/
*.zip
# ...but keep the metadata log and folder structure:
!data/metadata/
!data/metadata/*.csv
!data/**/.gitkeep

# --- Model weights (large binaries) ---
models/
*.pt
*.pth
*.onnx
*.engine
*.weights
# YOLOv10 base weights auto-downloaded to the project root:
yolov10*.pt
yolo26*.pt
yolo11*.pt

# --- Training / inference outputs ---
runs/
outputs/
results/
logs/
wandb/
*.log

# --- Metrics: keep the small JSON/TXT summaries, ignore heavy artifacts ---
metrics/*.png
metrics/*.jpg

# --- Cloned reference repos (external, have their own git history) ---
third_party/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# --- Local DB backups ---
backups/

# PLAN_V2 Phase 6.1 — admin password hash (never commit)
configs/admin_auth.json

# Google Drive credentials & sync state (NEVER commit)
configs/gdrive_credentials.json
configs/gdrive_token.json
configs/gdrive_sync_state.json
configs/_gdrive_test.txt


# Secrets — path-independent, so an accidental folder move can never expose them
**/gdrive_credentials.json
**/gdrive_token.json
**/gdrive_sync_state.json
**/admin_auth.json

# --- Runtime database + backups (recreate with: python scripts/database/setup.py) ---
plates.db
plates.db.*

# --- Evidence photos: real license plates captured at the gate. Never public. ---
photos/*
!photos/.gitkeep

# --- Dataset folders that were missing from the rules above ---
data/province_crops/*
!data/province_crops/manifest.json
data/number_annotation/
data/number_detect/*
!data/number_detect/data.yaml
*.cache
